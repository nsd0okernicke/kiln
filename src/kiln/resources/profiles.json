    "mixed-backends": {
      "description": "Same topology as the default profile, but validates the deterministic scheduler across backends at once: specifier and refactorer run on codex, everything else on claude. Copilot is parked out of scheduler-mode rotation for now -- see github/copilot-cli#4433 (non-interactive sessions silently and permanently lose write permission mid-session).",
      "terminals": [
        {
          "role": "human-in-the-loop",
          "agent": "claude",
          "worktree": "@current",
          "title": "Kiln Human-in-the-Loop",
          "mode": "manual",
          "model": "claude-sonnet-5"
