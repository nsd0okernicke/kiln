flowchart LR
    S("<b>Specifier</b><br/>writes Gherkin<br/>acceptance tests")
    C("<b>Coder</b><br/>TDD implementation")
    R("<b>Refactorer</b><br/>coverage · CRAP ·<br/>mutation testing")
    A("<b>Architect</b><br/>design review")

    S -->|"branch: main-coder"| C
    C -->|"branch: main-refactorer"| R
    R -->|"branch: main-architect"| A
    A -.->|"approved → next feature"| S

    classDef specifier fill:#2a78d6,color:#ffffff,stroke:#184f95,stroke-width:2px
    classDef coder fill:#eb6834,color:#ffffff,stroke:#a8431e,stroke-width:2px
    classDef refactorer fill:#1baf7a,color:#ffffff,stroke:#0f7a52,stroke-width:2px
    classDef architect fill:#eda100,color:#1a1a19,stroke:#a86e00,stroke-width:2px

    class S specifier
    class C coder
    class R refactorer
    class A architect
