{
  "version": "1.0",
  "description": "Kiln configuration profiles for different development scenarios",
  "profiles": {
    "dev": {
      "description": "Local development setup with standard 4-agent swarm in tabs",
      "terminals": [
        {
          "role": "specifier",
          "agent": "copilot",
          "worktree": "@current",
          "title": "Kiln Specifier"
        },
        {
          "role": "coder",
          "agent": "claude",
          "worktree": "coder",
          "title": "Kiln Coder",
          "model": "claude-haiku-4-5-20251001"
        },
        {
          "role": "refactorer",
          "agent": "claude",
          "worktree": "refactorer",
          "title": "Kiln Refactorer",
          "model": "claude-haiku-4-5-20251001"
        },
        {
          "role": "architect",
          "agent": "claude",
          "worktree": "architect",
          "title": "Kiln Architect",
          "model": "claude-haiku-4-5-20251001"
        }
      ],
      "layout": {
        "type": "tabs",
        "roles": [
          "specifier",
          "coder",
          "refactorer",
          "architect"
        ]
      },
      "messageBackend": "sqlite",
      "logLevel": "info",
      "env": {
        "DEBUG": "false"
      }
    },
