          "scheduler": "inbox",
          "watches": "human-in-the-loop"
        },
        {
          "role": "specifier",
          "agent": "codex",
          "worktree": "specifier",
          "title": "Kiln Specifier (Codex)",
          "mode": "auto",
          "scheduler": "python",
          "workerDebug": true
        },
        {
          "role": "coder",
          "agent": "claude",
          "worktree": "coder",
          "title": "Kiln Coder",
