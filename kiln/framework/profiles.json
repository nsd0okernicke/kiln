{
  "version": "1.0",
  "description": "Kiln configuration profiles for different development scenarios",
  "default": "default",
  "profiles": {
    "compact": {
      "description": "Compact pane layout with all roles in one tab (2x2 grid)",
      "terminals": [
        {
          "role": "specifier",
          "agent": "claude",
          "worktree": "@current",
          "title": "Kiln Specifier",
          "mode": "manual",
          "model": "claude-sonnet-5"
        },
        {
          "role": "coder",
          "agent": "copilot",
          "worktree": "coder",
          "title": "Kiln Coder",
          "mode": "auto"
        },
        {
          "role": "refactorer",
          "agent": "claude",
          "worktree": "refactorer",
          "title": "Kiln Refactorer",
          "mode": "auto",
          "model": "claude-sonnet-5"
        },
        {
          "role": "architect",
          "agent": "claude",
          "worktree": "architect",
          "title": "Kiln Architect",
          "mode": "auto",
          "model": "claude-sonnet-5"
        }
      ],
      "layout": {
        "tabs": [
          {
            "title": "All Roles",
            "gridRows": 2,
            "gridCols": 2,
            "panes": [
              {
                "role": "specifier"
              },
              {
                "role": "coder"
              },
              {
                "role": "refactorer"
              },
              {
                "role": "architect"
              }
            ]
          }
        ]
      },
      "messageBackend": "sqlite",
      "logLevel": "info",
      "env": {
        "DEBUG": "false"
      }
    },
    "tabs": {
      "description": "Standard 4-agent swarm in separate tabs",
      "terminals": [
        {
          "role": "specifier",
          "agent": "claude",
          "worktree": "@current",
          "title": "Kiln Specifier",
          "mode": "manual",
          "model": "claude-sonnet-5"
        },
        {
          "role": "coder",
          "agent": "claude",
          "worktree": "coder",
          "title": "Kiln Coder",
          "mode": "auto",
          "model": "claude-haiku-4-5-20251001",
          "workerModel": "claude-sonnet-5"
        },
        {
          "role": "refactorer",
          "agent": "claude",
          "worktree": "refactorer",
          "title": "Kiln Refactorer",
          "mode": "auto",
          "model": "claude-haiku-4-5-20251001",
          "workerModel": "claude-sonnet-5"
        },
        {
          "role": "architect",
          "agent": "claude",
          "worktree": "architect",
          "title": "Kiln Architect",
          "mode": "auto",
          "model": "claude-haiku-4-5-20251001",
          "workerModel": "claude-sonnet-5"
        }
      ],
      "layout": {
        "type": "tabs",
        "roles": [
          "specifier",
          "coder",
          "refactorer",
          "architect"
        ]
      },
      "messageBackend": "sqlite",
      "logLevel": "info",
      "env": {
        "DEBUG": "false"
      }
    },
    "default": {
      "description": "Human-guided request intake (human-in-the-loop) feeding a fully autonomous specifier -> coder -> refactorer -> architect cycle",
      "terminals": [
        {
          "role": "human-in-the-loop",
