{
  "version": "1.0",
  "description": "Kiln configuration profiles for different development scenarios",
  "default": "default",
  "profiles": {
    "compact": {
      "description": "Compact pane layout with all roles in one tab (2x2 grid)",
      "terminals": [
        {
          "role": "specifier",
          "agent": "claude",
          "worktree": "@current",
          "title": "Kiln Specifier",
          "mode": "manual",
          "model": "claude-sonnet-5"
        },
        {
          "role": "coder",
          "agent": "copilot",
          "worktree": "coder",
          "title": "Kiln Coder",
          "mode": "auto"
        },
        {
          "role": "refactorer",
          "agent": "claude",
          "worktree": "refactorer",
          "title": "Kiln Refactorer",
          "mode": "auto",
          "model": "claude-sonnet-5"
        },
        {
          "role": "architect",
          "agent": "claude",
          "worktree": "architect",
          "title": "Kiln Architect",
          "mode": "auto",
          "model": "claude-sonnet-5"
        }
      ],
      "layout": {
        "tabs": [
          {
            "title": "All Roles",
            "gridRows": 2,
            "gridCols": 2,
            "panes": [
              {
                "role": "specifier"
              },
              {
                "role": "coder"
              },
              {
                "role": "refactorer"
              },
              {
                "role": "architect"
              }
            ]
          }
        ]
      },
      "messageBackend": "sqlite",
      "logLevel": "info",
      "env": {
        "DEBUG": "false"
      }
    },
    "tabs": {
      "description": "Standard 4-agent swarm in separate tabs",
      "terminals": [
        {
          "role": "specifier",
