          "title": "Kiln Dashboard",
          "mode": "manual",
          "scheduler": "dashboard"
        }
      ],
      "routing": {
        "human-in-the-loop": "coder",
        "coder": "architect",
        "architect": "human-in-the-loop"
      },
      "layout": {
        "tabs": [
          {
            "title": "Human-in-the-Loop",
            "panes": [
              {
                "role": "human-in-the-loop"
              },
              {
