        },
        {
          "role": "architect",
          "agent": "claude",
          "worktree": "architect",
          "title": "Kiln Architect",
          "mode": "auto",
          "model": "claude-sonnet-5"
        }
      ],
      "layout": {
        "tabs": [
          {
            "title": "Human-in-the-Loop",
            "panes": [
              {
                "role": "human-in-the-loop"
              }
            ]
          },
          {
            "title": "Autonomous Cycle",
            "gridRows": 2,
            "gridCols": 2,
            "panes": [
              {
                "role": "specifier"
              },
              {
                "role": "coder"
              },
              {
                "role": "refactorer"
              },
              {
                "role": "architect"
              }
            ]
          }
        ]
      }
    },
    "scheduler-all": {
      "description": "Every auto-mode role runs on the deterministic Python scheduler; human-in-the-loop stays an interactive session with a live inbox pane beneath it",
      "terminals": [
        {
          "role": "human-in-the-loop",
          "agent": "claude",
          "worktree": "@current",
          "title": "Kiln Human-in-the-Loop",
          "mode": "manual",
          "model": "claude-sonnet-5"
        },
        {
          "role": "inbox",
          "worktree": "@current",
          "title": "Kiln Inbox",
          "mode": "manual",
          "scheduler": "inbox",
          "watches": "human-in-the-loop"
        },
        {
          "role": "specifier",
          "agent": "claude",
          "worktree": "specifier",
          "title": "Kiln Specifier",
          "mode": "auto",
          "model": "claude-sonnet-5",
          "scheduler": "python"
        },
        {
          "role": "coder",
          "agent": "claude",
          "worktree": "coder",
          "title": "Kiln Coder",
          "mode": "auto",
