        },
        {
          "role": "dashboard",
          "worktree": "@current",
          "title": "Kiln Dashboard",
          "mode": "manual",
          "scheduler": "dashboard"
        }
      ],
      "layout": {
        "tabs": [
          {
            "title": "Human-in-the-Loop",
            "panes": [
              {
                "role": "human-in-the-loop"
              },
              {
                "role": "inbox",
                "direction": "Bottom",
                "size": 0.22
              }
            ]
          },
          {
            "title": "Autonomous Cycle",
            "gridRows": 2,
            "gridCols": 2,
            "panes": [
              {
                "role": "specifier"
              },
              {
                "role": "coder"
              },
              {
                "role": "refactorer"
              },
              {
