        },
        {
          "role": "refactorer",
          "agent": "codex",
          "worktree": "refactorer",
          "title": "Kiln Refactorer (Codex)",
          "mode": "auto",
          "scheduler": "python"
        },
        {
          "role": "architect",
          "agent": "codex",
          "worktree": "architect",
          "title": "Kiln Architect (Codex)",
          "mode": "auto",
          "scheduler": "python"
        },
        {
          "role": "dashboard",
          "worktree": "@current",
          "title": "Kiln Dashboard",
          "mode": "manual",
          "scheduler": "dashboard"
        }
      ],
      "layout": {
        "tabs": [
          {
            "title": "Human-in-the-Loop",
            "panes": [
              {
                "role": "human-in-the-loop"
              },
              {
                "role": "inbox",
                "direction": "Bottom",
                "size": 0.22
              }
            ]
          },
          {
            "title": "Autonomous Cycle",
            "gridRows": 2,
