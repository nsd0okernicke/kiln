    "scheduler-coder": {
      "description": "Same cycle as default, but the coder runs on the deterministic Python scheduler (opt-in validation profile for the scheduler rollout)",
      "terminals": [
        {
          "role": "human-in-the-loop",
          "agent": "claude",
          "worktree": "@current",
          "title": "Kiln Human-in-the-Loop",
          "mode": "manual",
          "model": "claude-sonnet-5"
        },
        {
          "role": "specifier",
          "agent": "claude",
          "worktree": "specifier",
          "title": "Kiln Specifier",
          "mode": "auto",
          "model": "claude-sonnet-5"
        },
        {
          "role": "coder",
          "agent": "claude",
          "worktree": "coder",
          "title": "Kiln Coder",
          "mode": "auto",
          "model": "claude-sonnet-5",
          "scheduler": "python"
        },
        {
          "role": "refactorer",
          "agent": "claude",
          "worktree": "refactorer",
          "title": "Kiln Refactorer",
          "mode": "auto",
